---
layout: base.njk
---
<!-- ===== NAVIGATION ===== -->
<nav id="navbar">
    <div class="nav-inner">
        <a href="/" class="nav-brand">
            מ.ס.ו.ג.ל.ו.ת <span class="brand-dot">·</span>
        </a>
        <ul class="nav-links" id="nav-links">
            <li><a href="/" class="nav-link">בית</a></li>
            <li>
                <a href="/blog/" class="nav-link active">בלוג</a>
            </li>
            <li>
                <a href="/#contact" class="nav-link">להרשמה</a>
            </li>
        </ul>
    </div>
</nav>

<!-- ===== ARTICLE HERO ===== -->
<section class="article-hero" id="hero">
    <div class="container">
        <div class="article-hero-content">
            <span class="hero-label" style="margin-bottom: 24px; display: inline-block;">{{ category }}</span>
            <h1 class="hero-title" style="margin-bottom: 24px;">
                <span class="line">{{ title }}</span>
            </h1>
            <p class="hero-sub" style="max-width: 800px; margin: 0 auto; font-size: 1.25rem;">
                {{ description }}
            </p>
        </div>
    </div>
    <div class="section-glow bottom"></div>
</section>

<!-- ===== ARTICLE CONTENT ===== -->
<section class="article-content-wrapper">
    <div class="container" style="max-width: 840px;">
        <div class="article-back">
            <a href="/blog/#articles-list" class="btn-ghost dark-ghost">
                ← חזרה לכל המאמרים
            </a>
        </div>
        
        {% if image %}
        <div class="article-featured-image">
            <img src="{{ image }}" alt="{{ title }}" />
        </div>
        {% endif %}

        <article class="article-body">
            {{ content | safe }}
        </article>

        <div class="article-author-block">
            <div class="author-avatar">
                <div class="avatar-placeholder">מ.ס</div>
            </div>
            <div class="author-info">
                <h4>נכתב על ידי צוות מסוגלות</h4>
                <p>מאמנים ואנשי מקצוע מתחום התקשורת והתנועה, המוקדשים לקידום בני נוער מיוחדים.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===== FOOTER ===== -->
<footer id="footer">
    <div class="container">
        <div class="footer-inner">
            <div class="footer-brand">
                <span class="footer-name">מ.ס.וג.ל.ו.ת</span>
                <span class="footer-tagline">מסגרת ספורטיבית וגיבושית לתקשורת ותנועה</span>
            </div>
            <div class="footer-links">
                <a href="/" class="nav-link">חזרה לבית</a>
                <a href="mailto:hello@msglvut.co.il" class="social-link" id="footer-email" aria-label="Email">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                        <polyline points="22,6 12,13 2,6" />
                    </svg>
                    יצירת קשר
                </a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 מ.ס.וג.ל.ו.ת. כל הזכויות שמורות.</p>
        </div>
    </div>
</footer>
